# startx: the X Window System on the whole screen.
#
#   startx              the X server (Xfbdev) with fvwm95 (a taskbar and a
#                       Start menu) and a terminal (rxvt)
#   startx PROGRAM...   the X server and PROGRAM instead (e.g. startx evilwm)
#
# Quitting fvwm95 (Start, Shut Down) or Ctrl+Alt+Backspace stops X and comes
# back here. The X server's messages are in /tmp/Xfbdev.log, its programs'
# in /tmp/startx.log.

if ! [ -x /bin/Xfbdev ]; then
    echo "startx: no X server (build it with tools/ports/tinyx.sh)" >&2
    exit 1
fi
if [ -S /tmp/.X11-unix/X0 ] && busybox pgrep Xfbdev >/dev/null; then
    echo "startx: X is already running (DISPLAY=:0)" >&2
    exit 1
fi
rm -f /tmp/.X11-unix/X0

Xfbdev :0 >/tmp/Xfbdev.log 2>&1 &
x=$!

# Wait for it to listen (not a fixed time: X programs started too early
# just quit).
i=0
while ! [ -S /tmp/.X11-unix/X0 ]; do
    if ! kill -0 $x 2>/dev/null; then
        wait $x
        echo "startx: the X server stopped (status $?):" >&2
        tail -5 /tmp/Xfbdev.log >&2
        exit 1
    fi
    i=$((i + 1))
    if [ $i -gt 300 ]; then
        echo "startx: the X server didn't start (see /tmp/Xfbdev.log)" >&2
        kill $x
        exit 1
    fi
    sleep 0.1
done

export DISPLAY=:0
: >/tmp/startx.log
if [ $# -gt 0 ]; then
    "$@" >>/tmp/startx.log 2>&1 &
elif command -v fvwm95 >/dev/null; then
    # It opens a terminal itself. Quitting it ends the session.
    (fvwm95 >>/tmp/startx.log 2>&1; kill $x 2>/dev/null) &
else
    evilwm >>/tmp/startx.log 2>&1 &
    rxvt >>/tmp/startx.log 2>&1 &
fi

# Until the X server ends (Ctrl+Alt+Backspace); its programs quit with it
# (their connection is gone).
wait $x
rm -f /tmp/.X11-unix/X0
echo "X stopped."
