# fvwm95's configuration on PalladiumOS: /usr/lib/X11/fvwm95/system.fvwm95rc
# (used when there's no ~/.fvwm95rc). Made from fvwm95 2.0.43f's own
# system.fvwm95rc (GPL, like fvwm95): its styles, window functions, window
# menus, bindings and taskbar, and a Start menu of PalladiumOS's programs.
# Fonts: Adobe's Helvetica (tools/ports/fonts.sh), as fvwm95's own setup.

#------------------------------------------------------------------------------
# Fonts and colors
#------------------------------------------------------------------------------

WindowFont      -adobe-helvetica-bold-r-normal--12-*-75-75-*-*-*-*
IconFont        fixed
MenuFont        -adobe-helvetica-medium-r-normal--12-*-75-75-*-*-*-*

DefaultColors   Black #c3c3c3 #c3c3c3 #828282
HilightColors   White #000080
StickyColors    #828282 #a6caf0

#------------------------------------------------------------------------------
# Windows
#------------------------------------------------------------------------------

Style "*" NoIcon
Style "*" SloppyFocus
Style "*" MWMFunctions
Style "*" HintOverride
Style "*" MWMDecor
Style "*" OLDecor
Style "*" RandomPlacement, SmartPlacement
Style "*" BorderWidth 5, HandleWidth 5
OpaqueMoveSize 10
EdgeScroll 100 100
EdgeResistance 800 100
DeskTopSize 1x1

Style "Fvwm*"        NoTitle, Sticky, WindowListSkip
Style "FvwmBanner"   StaysOnTop
Style "FvwmTaskBar"  NoTitle, BorderWidth 4, HandleWidth 4, Sticky, \
                     StaysOnTop, WindowListSkip, CirculateSkip

ModulePath /usr/lib/X11/fvwm95/
PixmapPath /usr/lib/X11/pixmaps/
IconPath   /usr/lib/X11/mini-icons/

Style "*"      TitleIcon mini-x2.xpm
Style "rxvt"   TitleIcon mini-term.xpm
Style "xterm"  TitleIcon mini-term.xpm
Style "Links*" TitleIcon mini-nscape.xpm
Style "Xfm"    TitleIcon mini-filemgr.xpm
Style "*.xfm"  TitleIcon mini-filemgr.xpm
Style "xclock" TitleIcon mini-clock.xpm
Style "xcalc"  TitleIcon mini-calc.xpm
Style "xeyes"  TitleIcon mini-eyes.xpm
Style "xlogo"  TitleIcon mini-bx2.xpm
Style "xedit"  TitleIcon mini-edit.xpm
Style "xload"  TitleIcon mini-perf.xpm
Style "oclock" TitleIcon mini-clock.xpm
Style "XFontSel" TitleIcon mini-font.xpm
Style "xmag"   TitleIcon mini-zoom.xpm
Style "bitmap" TitleIcon mini-paint.xpm
Style "Ico*"   TitleIcon mini-bball.xpm
Style "xmessage" TitleIcon mini-exclam.xpm
Style "doomgeneric" TitleIcon mini-happy.xpm
Style "xboard" TitleIcon mini-slon.xpm
Style "*Jewel*" TitleIcon mini-bball.xpm

#------------------------------------------------------------------------------
# At start
#------------------------------------------------------------------------------

DestroyFunc "InitFunction"
AddToFunc "InitFunction"    "I" Exec xpmroot /usr/lib/X11/pixmaps/desktop.xpm
+                           "I" Module FvwmTaskBar
+                           "I" Module FvwmBanner
+                           "I" Exec rxvt

DestroyFunc "RestartFunction"
AddToFunc "RestartFunction" "I" Module FvwmTaskBar

#------------------------------------------------------------------------------
# Window functions (fvwm95's)
#------------------------------------------------------------------------------

DestroyFunc "Move-or-Raise"
AddToFunc "Move-or-Raise" "M" Move
+                         "M" Raise
+                         "C" Raise
+                         "D" Maximize 0 100

DestroyFunc "Move-or-Iconify"
AddToFunc "Move-or-Iconify" "M" Move
+                           "D" Iconify

DestroyFunc "Resize-or-Raise"
AddToFunc "Resize-or-Raise" "M" Resize
+                           "M" Raise
+                           "C" Raise
+                           "D" RaiseLower

DestroyFunc "window_ops_func"
AddToFunc "window_ops_func" "C" PopUp Window-Ops2
+                           "M" PopUp Window-Ops2
+                           "D" Delete

#------------------------------------------------------------------------------
# The Start menu
#------------------------------------------------------------------------------

DestroyMenu "StartMenu"
AddToMenu "StartMenu@fvwm-menu.xpm@^#808080^" \
  "&Programs%programs.xpm%"         Popup Programs
+ "&Terminal%mini-term.xpm%"        Exec rxvt
+ ""                                Nop
+ "Sh&ut Down%shutdown.xpm%"        Popup Shutdown

DestroyMenu "Programs"
AddToMenu "Programs" \
  "Accessories%mini-hammer.xpm%"    Popup Accessories
+ "Games%mini-happy.xpm%"           Popup Games
+ "System tools%mini-modules.xpm%"  Popup SystemTools
+ ""                                Nop
+ "Terminal%mini-term.xpm%"         Exec rxvt
+ "XTerm%mini-term.xpm%"            Exec xterm
+ "Web browser (Links)%mini-nscape.xpm%" Exec links -g https://example.com/
+ "File manager (xfm)%mini-filemgr.xpm%" Exec xfm
+ "Processes (top)%mini-run.xpm%"   Exec rxvt -T top -e busybox top
+ "System info%mini-bx2.xpm%"       Exec rxvt -T fastfetch -e sh -c "fastfetch; sh"
+ "Text editor%mini-edit.xpm%"      Exec rxvt -T edit -e edit
+ "vi%mini-edit.xpm%"               Exec rxvt -T vi -e vi
+ "Vim%mini-edit.xpm%"              Exec xterm -T Vim -e vim
+ ""                                Nop
+ "Python%mini-run.xpm%"            Exec rxvt -T MicroPython -e micropython
+ "Lua%mini-run.xpm%"               Exec rxvt -T Lua -e lua
+ "Tcl/Tk: widget tour%mini-modules.xpm%" Exec wish /usr/lib/tk8.6/demos/widget
+ "Alpine Linux%mini-penguin.xpm%"  Exec rxvt -T Alpine -e alpine

DestroyMenu "Accessories"
AddToMenu "Accessories" \
  "Calculator%mini-calc.xpm%"       Exec xcalc
+ "Text editor (xedit)%mini-edit.xpm%" Exec xedit
+ "Magnifying glass%mini-zoom.xpm%" Exec xmag
+ "Font viewer%mini-font.xpm%"      Exec xfontsel
+ "Bitmap editor%mini-paint.xpm%"   Exec bitmap
+ ""                                Nop
+ "Clock%mini-clock.xpm%"           Exec xclock
+ "Round clock%mini-clock.xpm%"     Exec oclock
+ "System load%mini-perf.xpm%"      Exec xload
+ "Eyes%mini-eyes.xpm%"             Exec xeyes
+ "Polyhedron%mini-bball.xpm%"      Exec ico
+ "X logo%mini-bx2.xpm%"            Exec xlogo

DestroyMenu "Games"
AddToMenu "Games" \
  "DOOM (Freedoom)%mini-happy.xpm%" Exec doom
+ "Chess (XBoard)%mini-slon.xpm%"   Exec xboard
+ "Jewels%mini-bball.xpm%"          Exec xjewel
+ "Mahjongg%mini-xmahjongg.xpm%"    Exec xmahjongg
+ "DOS games%mini-cd.xpm%"          Popup DosGames
+ "NES games%mini-tetris.xpm%"      Exec nes
+ ""                                Nop
+ "Let it snow (xsnow)%mini-xsnow.xpm%" Exec xsnow
+ "Roaches (xroach)%mini-roach.xpm%" Exec xroach
+ "Stop snow and roaches%mini-stop.xpm%" Exec busybox pkill -x "xsnow|xroach"

DestroyMenu "DosGames"
AddToMenu "DosGames" \
  "WORDLOS (Wordle)%mini-happy.xpm%" Exec wordlos
+ "Floppy Bird%mini-happy.xpm%"     Exec floppybird
+ "DOSBox (a DOS prompt)%mini-term.xpm%" Exec dosbox

DestroyMenu "SystemTools"
AddToMenu "SystemTools" \
  "Input events (xev)%mini-hex.xpm%" Exec rxvt -T xev -e xev
+ "Window info (click one)%mini-ray.xpm%" Exec rxvt -T xwininfo -e sh -c "xwininfo; sleep 60"
+ "Display info%mini-display.xpm%"  Exec rxvt -T xdpyinfo -e sh -c "xdpyinfo | busybox less"
+ "Kill a window (click it)%mini-crosbone.xpm%" Exec xkill
+ "Screenshot (/tmp/screen.xwd)%mini-camera.xpm%" Exec sh -c "xwd -root -out /tmp/screen.xwd && xmessage 'Saved /tmp/screen.xwd (view: xwud -in /tmp/screen.xwd)'"

DestroyMenu "Shutdown"
AddToMenu "Shutdown" \
  "Restart fvwm95%mini-turn.xpm%"   Restart fvwm95
+ "Quit fvwm95%mini-exclam.xpm%"    Quit

#------------------------------------------------------------------------------
# The desktop and window menus (fvwm95's)
#------------------------------------------------------------------------------

DestroyMenu "Utilities"
AddToMenu "Utilities" \
  "Terminal%mini-term.xpm%"         Exec rxvt
+ "Processes (top)%mini-run.xpm%"   Exec rxvt -T top -e busybox top
+ ""                                Nop
+ "Restart fvwm95%mini-turn.xpm%"   Restart fvwm95
+ "Quit fvwm95%mini-exclam.xpm%"    Quit

DestroyMenu "Window"
AddToMenu "Window" "Window Ops" Title
+ "&Move%mini-move.xpm%"            Function Move-or-Raise
+ "&Resize%mini-resize.xpm%"        Function Resize-or-Raise
+ "R&aise%mini-raise.xpm%"          Raise
+ "&Lower%mini-lower.xpm%"          Lower
+ "(De)Iconify%mini-iconify.xpm%"   Iconify
+ "(Un)Maximize%mini-max1.xpm%"     Maximize 100 100
+ ""                                Nop
+ "Kill%mini-crosbone.xpm%"         Destroy
+ "&Close"                          Delete
+ ""                                Nop
+ "Switch to..."                    WindowList
+ "Refresh Screen%mini-ray.xpm%"    Refresh

DestroyMenu "Window-Ops2"
AddToMenu "Window-Ops2" "&Restore"  Iconify -1
+ "&Move"                           Move-or-Raise
+ "&Size"                           Resize-or-Raise
+ "Mi&nimize"                       Iconify 1
+ "Ma&ximize"                       Maximize 100 100
+ ""                                Nop
+ "&Kill"                           Destroy
+ "&Close	Alt+F4"                 Delete

#------------------------------------------------------------------------------
# Mouse and keys (fvwm95's)
#------------------------------------------------------------------------------

# On the desktop: left a menu, middle the window menu, right the windows.
Mouse 1     R       A       Menu "Utilities" Nop
Mouse 2     R       A       Menu "Window" Nop
Mouse 3     R       A       WindowList

# Title bar buttons: the menu, close, maximize, minimize.
Mouse 0     1       A       Function "window_ops_func"
Mouse 1     2       A       Delete
Mouse 0     4       A       Maximize 100 100
Mouse 0     6       A       Iconify

Mouse 1     FS      A       Function "Resize-or-Raise"
Mouse 1     T       A       Function "Move-or-Raise"
Mouse 1     I       A       Function "Move-or-Iconify"
Mouse 2     I       A       Iconify
Mouse 2     FST     A       Function "window_ops_func"
Mouse 3     TSIF    A       RaiseLower
Mouse 3     W       M       RaiseLower

Key F4      A       M       Delete
Key Tab     A       M       Next [*] Focus

#------------------------------------------------------------------------------
# Modules
#------------------------------------------------------------------------------

*FvwmBannerTimeout 2

*FvwmTaskBarGeometry +0-0
*FvwmTaskBarFore Black
*FvwmTaskBarBack #c0c0c0
*FvwmTaskBarFont -adobe-helvetica-medium-r-normal--12-*-75-75-*-*-*-*
*FvwmTaskBarSelFont -adobe-helvetica-bold-r-normal--12-*-75-75-*-*-*-*
*FvwmTaskBarStatusFont fixed
*FvwmTaskBarAction Click1 Iconify -1,Raise,Focus
*FvwmTaskBarAction Click2 Iconify
*FvwmTaskBarAction Click3 PopUp Window-Ops2
*FvwmTaskBarUseSkipList
*FvwmTaskBarAutoStick
*FvwmTaskBarStartName Start
*FvwmTaskBarStartMenu StartMenu
*FvwmTaskBarStartIcon mini-penguin.xpm
*FvwmTaskBarShowTips
*FvwmTaskBarShowTransients
*FvwmTaskBarHighlightFocus
*FvwmTaskBarDeskOnly

# The clock (and its date, as a tip), at the right of the taskbar. Its
# goodies are built into FvwmTaskBar (the plugin directory names them).
*FvwmTaskBarGoodyLoadablePlugins /usr/lib/X11/fvwm95/plugins
*FvwmTaskBarGoodyLoadableQuiet
*FvwmTaskBarGoodyLoadableSymbol ShowDateModuleSymbol
*FvwmTaskBarGoodyLoadableId .DATE
*FvwmTaskBarShowDateModuleTip.DATE Date
*FvwmTaskBarShowDateModuleClockFormat.DATE %H:%M
*FvwmTaskBarShowDateModuleCommand.DATE Exec xclock

*FvwmIdentFont -adobe-helvetica-medium-r-normal--12-*-75-75-*-*-*-*
